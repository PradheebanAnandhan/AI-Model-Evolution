{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "shortName": {
        "type": "string"
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "country": {
        "type": "string",
        "minLength": 2
      },
      "website": {
        "type": "string",
        "format": "uri"
      },
      "order": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "id",
      "name",
      "color",
      "country",
      "website",
      "order"
    ],
    "additionalProperties": false
  }
}
