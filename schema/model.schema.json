{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "org": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "releaseDate": {
      "type": "string",
      "pattern": "^\\d{4}(?:-(0[1-9]|1[0-2])(?:-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "type": {
      "type": "string",
      "enum": [
        "llm",
        "reasoning",
        "multimodal",
        "image",
        "video",
        "audio",
        "embedding",
        "code"
      ]
    },
    "modalities": {
      "type": "object",
      "properties": {
        "input": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ]
          }
        },
        "output": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ]
          }
        }
      },
      "required": [
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    "openness": {
      "type": "string",
      "enum": [
        "closed",
        "open-weights",
        "open-source"
      ]
    },
    "license": {
      "type": "string"
    },
    "architecture": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "properties": {
        "disclosed": {
          "type": "boolean"
        },
        "total": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "active": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "disclosed"
      ],
      "additionalProperties": false
    },
    "contextWindow": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "trainingCutoff": {
      "type": "string",
      "pattern": "^\\d{4}(?:-(0[1-9]|1[0-2])(?:-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "properties": {
              "disclosed": {
                "type": "boolean"
              },
              "total": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "active": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "disclosed"
            ],
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "default": {},
      "type": "object",
      "properties": {
        "paper": {
          "type": "string",
          "format": "uri"
        },
        "github": {
          "type": "string",
          "format": "uri"
        },
        "official": {
          "type": "string",
          "format": "uri"
        },
        "huggingface": {
          "type": "string",
          "format": "uri"
        },
        "modelCard": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "relations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "successor-of",
              "derived-from",
              "distilled-from",
              "inspired-by"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string"
          },
          "accessed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "url",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "citations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "releaseDate",
          "org",
          "openness",
          "parameters",
          "license",
          "architecture",
          "contextWindow",
          "trainingCutoff",
          "capabilities",
          "modalities",
          "variants",
          "relations",
          "summary"
        ]
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "draft"
      ]
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "id",
    "name",
    "org",
    "family",
    "releaseDate",
    "type",
    "modalities",
    "openness",
    "architecture",
    "parameters",
    "summary",
    "sources",
    "citations",
    "status",
    "updated"
  ],
  "additionalProperties": false
}
